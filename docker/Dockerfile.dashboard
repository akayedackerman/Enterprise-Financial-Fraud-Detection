FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy over your structured dashboard code folder
COPY dashboard/ /app/dashboard/

# Expose the default Streamlit visual portal network port
EXPOSE 8501

ENV PYTHONUNBUFFERED=1

# Instruct Streamlit to execute directly without launching localized browser frames inside the container
CMD ["python", "-m", "streamlit", "run", "dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0"]